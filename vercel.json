{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bebig.mvriba.com"
        }
      ],
      "destination": "/bebig",
      "permanent": false
    },
    {
      "source": "/:path((?!bebig$|bebig/|_vercel/|assets/).+)",
      "has": [
        {
          "type": "host",
          "value": "bebig.mvriba.com"
        }
      ],
      "destination": "/bebig",
      "permanent": false
    }
  ]
}
